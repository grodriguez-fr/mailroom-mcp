# Copy to .env next to compose.yaml and fill in. Secrets do not go here: see docs/deployment.md.
MAIL_IMAGE=mailroom-mcp:latest
# One mailbox:
MAIL_IMAP_HOST=imap.example.org
MAIL_USER=me@example.org
# Your other addresses delivered to or sent from this mailbox, comma-separated (optional):
# MAIL_ALIASES=me@old-job.example
# Sending drafts after your approval (send_draft), off by default; SMTP defaults to the IMAP host on port 465:
# MAIL_SEND_ENABLED=true
# MAIL_SMTP_HOST=smtp.example.org
# MAIL_SMTP_PORT=587
# MAIL_SMTP_SECURITY=starttls
# At most this many mails per hour (default 20; 0 disables sending, also with an accounts file):
# MAIL_SEND_LIMIT_PER_HOUR=20
# Or several (leave MAIL_IMAP_HOST and MAIL_USER unset): a JSON list of accounts in secrets/ (README.md)
# MAIL_ACCOUNTS_FILE=/run/secrets/accounts.json
MAIL_TIMEZONE=Europe/Paris
MAIL_PUBLIC_URL=https://mail-mcp.example.org
MAIL_GOOGLE_CLIENT_ID=1234-abcd.apps.googleusercontent.com
MAIL_GOOGLE_SUB=123456789012345678901
